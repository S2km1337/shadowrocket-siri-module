#!name=Siri & Apple Intelligence 代理
#!desc=Siri/听写、Private Cloud Compute、OHTTP Relay、Private Relay、CloudKit、地区检测 走 PROXY
#!category=Apple

[Rule]
# === Siri & Dictation 核心接口 ===
DOMAIN-SUFFIX,guzzoni.apple.com,PROXY
DOMAIN-SUFFIX,smoot.apple.com,PROXY
DOMAIN-SUFFIX,siri.apple.com,PROXY
DOMAIN-SUFFIX,api-siri-prod.apple.com,PROXY
DOMAIN-SUFFIX,seed-siri-apple-com.v.aaplimg.com,PROXY
DOMAIN-SUFFIX,nlp.apple.com,PROXY
DOMAIN-SUFFIX,prod.dss.apple.com,PROXY

# === Private Cloud Compute (PCC) & OHTTP Relay (含 ChatGPT 扩展转发) ===
DOMAIN-SUFFIX,apple-relay.apple.com,PROXY
DOMAIN-SUFFIX,apple-native-relay.apple.com,PROXY
DOMAIN-SUFFIX,apple-relay.cloudflare.com,PROXY
DOMAIN-SUFFIX,apple-carry-relay.cloudflare.com,PROXY
DOMAIN-SUFFIX,apple-relay.fastly-edge.com,PROXY
DOMAIN-SUFFIX,apple-relay.akamaized.net,PROXY
DOMAIN-SUFFIX,cp4.cloudflare.com,PROXY

# === Private Relay & OHTTP 网关鉴权/CNAME ===
DOMAIN-SUFFIX,mask.icloud.com,PROXY
DOMAIN-SUFFIX,mask-h2.icloud.com,PROXY
DOMAIN-SUFFIX,mask-api.icloud.com,PROXY
DOMAIN-SUFFIX,mask-boot.icloud.com,PROXY
DOMAIN-SUFFIX,mask-canary.icloud.com,PROXY
DOMAIN-SUFFIX,mask.apple-dns.net,PROXY
DOMAIN-SUFFIX,mask-t.apple-dns.net,PROXY
DOMAIN-SUFFIX,mask-api.fe.apple-dns.net,PROXY
DOMAIN-SUFFIX,mask-api.fe2.apple-dns.net,PROXY

# === CloudKit 网关与连通性探测 ===
DOMAIN-SUFFIX,gateway.icloud.com,PROXY
DOMAIN-SUFFIX,probe.icloud.com,PROXY
DOMAIN-SUFFIX,api.apple-cloudkit.com,PROXY

# === 地区检测防回退 (若导致苹果地图漂移可单独注释掉 wps) ===
DOMAIN,gspe1-ssl.ls.apple.com,PROXY
DOMAIN-SUFFIX,wps.apple.com,PROXY

DOMAIN-KEYWORD,siri,PROXY
